{
  "entities": {
    "users": {
      "title": "Usuários e Perfis",
      "description": "Perfis de clientes, síndicos, condomínios e colaboradores do sistema",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "tipoCadastro": { "type": "string", "enum": ["Fisica", "Juridica"] },
        "tipoCondominio": { "type": "string", "enum": ["Residencial", "Comercial"] },
        "quantidadeUnidades": { "type": "number", "description": "Quantidade de unidades no condomínio" },
        "telefone": { "type": "string" },
        "cpf": { "type": "string" },
        "cnpj": { "type": "string" },
        "nomeResponsavel": { "type": "string" },
        "cpfResponsavel": { "type": "string" },
        "funcao": { "type": "string" },
        "endereco": { "type": "string" },
        "numero": { "type": "string" },
        "complemento": { "type": "string" },
        "bairro": { "type": "string" },
        "cidade": { "type": "string" },
        "estado": { "type": "string" },
        "cep": { "type": "string" },
        "codigoIndicacao": { "type": "string" }
      },
      "required": ["email", "displayName", "role", "telefone", "quantidadeUnidades"]
    },
    "logs_sistema": {
      "title": "Logs de Auditoria do Sistema",
      "description": "Registros de auditoria de ações críticas no sistema",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID do usuário que executou a ação"
        },
        "userEmail": {
          "type": "string",
          "description": "E-mail do usuário que executou a ação"
        },
        "userName": {
          "type": "string",
          "description": "Nome de exibição do usuário"
        },
        "action": {
          "type": "string",
          "description": "Descrição sucinta da ação realizada"
        },
        "category": {
          "type": "string",
          "description": "Categoria/departamento do sistema",
          "enum": ["Administrativo", "Comercial", "Financeiro", "Estoque", "Sistema"]
        },
        "ip": {
          "type": "string",
          "description": "Endereço IP público do cliente"
        },
        "userAgent": {
          "type": "string",
          "description": "User Agent do navegador do cliente"
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora em que a ação ocorreu"
        }
      },
      "required": ["userId", "userEmail", "action", "category", "ip", "date"]
    },
    "integracao_pagamentos": {
      "title": "Integração de Pagamentos",
      "description": "Configurações das chaves de API dos gateways de pagamento",
      "type": "object",
      "properties": {
        "provedor": { "type": "string" },
        "publicKey": { "type": "string" },
        "accessToken": { "type": "string" },
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" },
        "status": { "type": "string", "enum": ["Ativo", "Modo Teste", "Inativo"] }
      },
      "required": ["provedor", "status"]
    },
    "centros_custo": {
      "title": "Centros de Custo e Lucro",
      "description": "Estrutura de centros de custo e centros de lucro para lançamentos contábeis e orçamentários",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "tipo": { "type": "string", "enum": ["custo", "lucro"] },
        "categoria": { "type": "string" },
        "centroPai": { "type": "string" },
        "descricao": { "type": "string" },
        "status": { "type": "string", "enum": ["Ativo", "Inativo"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "tipo", "categoria", "status"]
    },
    "contas_receber": {
      "title": "Contas a Receber",
      "description": "Lançamentos e faturas de contas a receber de clientes",
      "type": "object",
      "properties": {
        "descricao": { "type": "string" },
        "valor": { "type": "number" },
        "vencimento": { "type": "string" },
        "parcelas": { "type": "number" },
        "clienteId": { "type": "string" },
        "status": { "type": "string", "enum": ["Aberto", "Recebido", "Atrasado", "Auditar Web", "Cancelado"] },
        "recebidoEm": { "type": "string" },
        "valorRecebido": { "type": "number" },
        "contaBancaria": { "type": "string" },
        "centroCusto": { "type": "string" },
        "pedidoId": { "type": "string" }
      },
      "required": ["descricao", "valor", "vencimento", "status"]
    },
    "wishlist_item": {
      "title": "Item da Lista de Desejos",
      "description": "Associação de produto favoritado por um usuário",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID do produto favoritado"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora de quando o produto foi favoritado"
        }
      },
      "required": ["id", "addedAt"]
    },
    "cashback_transaction": {
      "title": "Transação de Cashback",
      "description": "Registro de ganho, resgate ou desconto de cashback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["earning", "withdrawal", "discount"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Aprovado", "Pendente", "Rejeitado"] }
      },
      "required": ["id", "type", "amount", "description", "date", "status"]
    },
    "cart_item": {
      "title": "Item do Carrinho de Compras",
      "description": "Item salvo no carrinho de compras do usuário para persistência",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "imagemPrincipal": { "type": "string" },
        "precoOriginal": { "type": "number" },
        "precoAplicado": { "type": "number" },
        "quantidade": { "type": "number" },
        "categoria": { "type": "string" },
        "sku": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nome", "precoOriginal", "precoAplicado", "quantidade"]
    },
    "configuracao_email": {
      "title": "Configurações de Notificação por E-mail",
      "description": "Configurações de servidor SMTP e credenciais de API de e-mail (SendGrid/Mailgun/Amazon SES) para disparos automáticos",
      "type": "object",
      "properties": {
        "metodo": { "type": "string", "enum": ["smtp", "api"] },
        "smtpHost": { "type": "string" },
        "smtpPort": { "type": "number" },
        "smtpUser": { "type": "string" },
        "smtpPass": { "type": "string" },
        "smtpSecure": { "type": "boolean" },
        "apiProvider": { "type": "string", "enum": ["sendgrid", "mailgun", "ses", "custom"] },
        "apiKey": { "type": "string" },
        "apiDomain": { "type": "string" },
        "apiEndpoint": { "type": "string" },
        "fromEmail": { "type": "string" },
        "fromName": { "type": "string" },
        "templates": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["metodo", "fromEmail", "fromName"]
    },
    "mural_notice": {
      "title": "Mural Condominial",
      "description": "Comunicados informativos ou perguntas/dúvidas compartilhadas entre síndicos",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "condominio": { "type": "string" },
        "bairro": { "type": "string" },
        "tipo": { "type": "string", "enum": ["comunicado", "duvida"] },
        "titulo": { "type": "string" },
        "texto": { "type": "string" },
        "status": { "type": "string", "enum": ["em_revisao", "publicado", "rejeitado"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "condominio", "bairro", "titulo", "texto", "status"]
    },
    "mural_resposta": {
      "title": "Resposta no Mural Condominial",
      "description": "Respostas e contribuições de outros síndicos para dúvidas no mural",
      "type": "object",
      "properties": {
        "noticeId": { "type": "string" },
        "userId": { "type": "string" },
        "autorNome": { "type": "string" },
        "condominio": { "type": "string" },
        "bairro": { "type": "string" },
        "texto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["noticeId", "userId", "texto", "condominio"]
    },
    "meta_vendas": {
      "title": "Metas de Vendas",
      "description": "Definição de metas de faturamento e volume comercial por mês e ano",
      "type": "object",
      "properties": {
        "ano": { "type": "number" },
        "metaAnual": { "type": "number" },
        "meses": { "type": "object" },
        "observacoes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["ano"]
    },
    "sugestoes": {
      "title": "Sugestões de Usuários e Condomínios",
      "description": "Sugestões enviadas por síndicos, condomínios e clientes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "condominio": { "type": "string" },
        "sindico": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "titulo": { "type": "string" },
        "mensagem": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titulo", "mensagem"]
    },
    "mail": {
      "title": "Fila de E-mails",
      "description": "Disparo assíncrono de notificações por e-mail",
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "message": { "type": "object" }
      },
      "required": ["to", "message"]
    },
    "suporte_mensagens": {
      "title": "Mensagens de Suporte",
      "description": "Atendimento e mensagens enviadas pelo portal do cliente",
      "type": "object",
      "properties": {
        "clienteUid": { "type": "string" },
        "clienteEmail": { "type": "string" },
        "clienteNome": { "type": "string" },
        "text": { "type": "string" },
        "sender": { "type": "string" },
        "statusAtendimento": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clienteUid", "text"]
    },
    "configuracao_royalties": {
      "title": "Configuração de Agendamento de Royalties",
      "description": "Parâmetros e regras de agendamento automático de apuração e faturamento de royalties das franqueadas",
      "type": "object",
      "properties": {
        "ativo": { "type": "boolean" },
        "diaFechamento": { "type": "number" },
        "diaVencimento": { "type": "number" },
        "aliquotaPadraoRoyalty": { "type": "number" },
        "aliquotaPadraoFundoPropaganda": { "type": "number" },
        "gerarContaReceberAutomaticamente": { "type": "boolean" },
        "notificarEmail": { "type": "boolean" },
        "emailNotificacao": { "type": "string" }
      },
      "required": ["ativo", "diaFechamento", "diaVencimento"]
    },
    "cobrancas_royalties": {
      "title": "Cobranças e Faturas de Royalties",
      "description": "Histórico de faturamentos mensais, royalties apurados e cobranças emitidas para as franqueadas",
      "type": "object",
      "properties": {
        "competencia": { "type": "string" },
        "franqueadaId": { "type": "string" },
        "codigoUnidade": { "type": "string" },
        "faturamentoBruto": { "type": "number" },
        "valorRoyalties": { "type": "number" },
        "valorFundoPropaganda": { "type": "number" },
        "valorTotal": { "type": "number" },
        "dataVencimento": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendente", "Faturado", "Pago", "Cancelado"] },
        "contaReceberId": { "type": "string" }
      },
      "required": ["competencia", "codigoUnidade", "valorTotal", "status"]
    },
    "solicitacao_boleto": {
      "title": "Solicitações de Emissão de Boletos em Atraso",
      "description": "Pedidos de emissão de 2ª via ou novo boleto para pagamento de mensalidade em atraso",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "afiliacaoId": { "type": "string" },
        "nomeCliente": { "type": "string" },
        "cnpj": { "type": "string" },
        "representadoPor": { "type": "string" },
        "emailEnvio": { "type": "string" },
        "parcelaId": { "type": "string" },
        "numeroParcela": { "type": "string" },
        "valor": { "type": "number" },
        "vencimentoOriginal": { "type": "string" },
        "status": { "type": "string" },
        "tipo": { "type": "string" },
        "solicitadoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "emailEnvio", "valor", "status"]
    },
    "config_empresa": {
      "title": "Cadastro de Empresas Franqueadas",
      "description": "Dados cadastrais, contratuais, fiscais e de e-mails para contato departamental das empresas franqueadas",
      "type": "object",
      "properties": {
        "razaoSocial": { "type": "string" },
        "nomeFantasia": { "type": "string" },
        "cnpj": { "type": "string" },
        "codigoUnidade": { "type": "string" },
        "statusFranquia": { "type": "string" },
        "email": { "type": "string" },
        "telefone": { "type": "string" },
        "emailDiretoria": { "type": "string", "description": "E-mail para contato com a Diretoria Executiva" },
        "emailComercial": { "type": "string", "description": "E-mail para contato com o Departamento Comercial" },
        "emailFinanceiro": { "type": "string", "description": "E-mail para contato com o Departamento Financeiro" },
        "emailSac": { "type": "string", "description": "E-mail para contato com o Serviço de Atendimento ao Cliente (SAC)" },
        "royalties": { "type": "string" },
        "fundoPropaganda": { "type": "string" },
        "cidade": { "type": "string" },
        "uf": { "type": "string" }
      },
      "required": ["razaoSocial"]
    },
    "cliente_contatos": {
      "title": "Contatos e Prestadores de Serviço do Cliente",
      "description": "Lista de contatos, empresas e prestadores de serviços cadastrados pelo cliente/condomínio",
      "type": "object",
      "properties": {
        "clienteId": { "type": "string" },
        "clienteEmail": { "type": "string" },
        "nomeEmpresa": { "type": "string" },
        "cnpjCpf": { "type": "string" },
        "nomeContato": { "type": "string" },
        "telefone": { "type": "string" },
        "atendimentoUrgencia": { "type": "string", "enum": ["Sim", "Não", "Não se Aplica"] },
        "especialidades": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observacoes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clienteId", "nomeContato", "telefone"]
    }
  },
  "firestore": {
    "cliente_contatos/{contatoId}": {
      "schema": "cliente_contatos",
      "description": "Coleção de contatos e prestadores de serviços cadastrados por cada cliente ou condomínio"
    },
    "config_empresa/{empresaId}": {
      "schema": "config_empresa",
      "description": "Coleção de configurações e cadastro das empresas franqueadas"
    },
    "solicitacoes_boletos/{solicitacaoId}": {
      "schema": "solicitacao_boleto",
      "description": "Coleção de solicitações de emissão de boletos para mensalidades em atraso"
    },
    "users/{userId}": {
      "schema": "users",
      "description": "Documentos de perfis de usuários e clientes cadastrados"
    },
    "configuracao_royalties/{configId}": {
      "schema": "configuracao_royalties",
      "description": "Configurações do motor de agendamento de faturamento de royalties"
    },
    "cobrancas_royalties/{cobrancaId}": {
      "schema": "cobrancas_royalties",
      "description": "Registro analítico de cobranças mensais de royalties e marketing da rede de franqueadas"
    },
    "sugestoes/{sugestaoId}": {
      "schema": "sugestoes",
      "description": "Coleção de sugestões enviadas por clientes e visitantes"
    },
    "mail/{mailId}": {
      "schema": "mail",
      "description": "Fila de mensagens para envio de e-mails"
    },
    "suporte_mensagens/{msgId}": {
      "schema": "suporte_mensagens",
      "description": "Mensagens de suporte ao cliente"
    },
    "metas_vendas/{metaId}": {
      "schema": "meta_vendas",
      "description": "Coleção de metas de vendas mensais e anuais por ano"
    },
    "muralNotices/{noticeId}": {
      "schema": "mural_notice",
      "description": "Coleção de comunicados e dúvidas do mural condominial"
    },
    "muralNotices/{noticeId}/respostas/{respostaId}": {
      "schema": "mural_resposta",
      "description": "Subcoleção de respostas e orientações de síndicos para cada comunicado ou dúvida"
    },
    "config/email": {
      "schema": "configuracao_email",
      "description": "Configurações globais de e-mail e notificações por SMTP ou API"
    },
    "logs_sistema": {
      "schema": "logs_sistema",
      "description": "Coleção global de logs de auditoria"
    },
    "integracao_pagamentos": {
      "schema": "integracao_pagamentos",
      "description": "Coleção de configurações de gateways de pagamento"
    },
    "centros_custo": {
      "schema": "centros_custo",
      "description": "Coleção de centros de custo e de lucro da empresa"
    },
    "contas_receber": {
      "schema": "contas_receber",
      "description": "Coleção de lançamentos de contas a receber"
    },
    "users/{userId}/wishlist/{productId}": {
      "schema": "wishlist_item",
      "description": "Subcoleção contendo itens da lista de desejos de cada usuário"
    },
    "users/{userId}/cashback_transactions/{transactionId}": {
      "schema": "cashback_transaction",
      "description": "Histórico de lançamentos e resgates de cashback do usuário"
    },
    "users/{userId}/cart/{productId}": {
      "schema": "cart_item",
      "description": "Itens no carrinho de compras do usuário para persistência entre sessões"
    }
  }
}
